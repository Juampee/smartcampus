# Copia este fichero a .env y ajusta los valores. NO subas .env al repositorio.
APP_ENV=development
HOST=0.0.0.0
PORT=5000
# Puerto expuesto en el host por docker compose
HOST_PORT=5000
# Ruta del fichero SQLite (en Docker se monta un volumen en /data)
DB_PATH=./data/smartcampus.db
LOG_LEVEL=INFO
GUNICORN_WORKERS=2
# Secreto de la aplicacion (en CI/CD se inyecta desde GitHub Secrets)
SECRET_KEY=change-me
